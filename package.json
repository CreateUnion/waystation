{
  "name": "waystation",
  "version": "0.2.7",
  "description": "局域网多机会话协作驿站（MCP stdio 进程）",
  "type": "module",
  "bin": {
    "waystation": "bin/waystation.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 --test-coverage-exclude=\"test/**\" \"test/**/*.test.js\"",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "gate": "npm run lint && npm run typecheck && npm run coverage"
  },
  "author": "xueweichao <xuecoder@aliyun.com> (lfemcp)",
